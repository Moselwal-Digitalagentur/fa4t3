{
    "name": "moselwal/fathom-analytics",
    "type": "typo3-cms-extension",
    "description": "Fathom Analytics Integration for TYPO3 CMS - Backend Dashboard, Page Analytics, Frontend Tracking",
    "license": "GPL-2.0-or-later",
    "keywords": [
        "TYPO3",
        "analytics",
        "fathom",
        "privacy",
        "dashboard"
    ],
    "repositories": {
        "175": {
            "type": "composer",
            "url": "https://gitlab.moselwal.io/api/v4/group/175/-/packages/composer/packages.json"
        }
    },
    "require": {
        "php": "^8.5",
        "typo3/cms-core": "^14.0",
        "typo3/cms-backend": "^14.0",
        "typo3/cms-fluid": "^14.0",
        "typo3/cms-extbase": "^14.0"
    },
    "suggest": {
        "moselwal/secret-resolver": "Secure resolution of API key and password from encrypted secrets (SOPS, Vault, etc.)"
    },
    "require-dev": {
        "moselwal/dev": "*",
        "typo3/testing-framework": "^9.0"
    },
    "config": {
        "gitlab-domains": [
            "gitlab.moselwal.io"
        ]
    },
    "autoload": {
        "psr-4": {
            "Moselwal\\FathomAnalytics\\": "Classes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Moselwal\\FathomAnalytics\\Tests\\": "Tests/"
        }
    },
    "scripts": {
        "test": "phpunit -c Tests/phpunit.xml",
        "phpstan": "phpstan analyse"
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "fathom_analytics"
        }
    }
}
